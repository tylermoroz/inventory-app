<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include("./partials/navbar", {itemTypes, weaponTypes, affinityTypes, spellTypes, spellSchools, potionTypes}) %> <%- include("./partials/errors") %>
    <h1><%= title %></h1>
    <ul>
      <% inventory.forEach((item) => { %>
      <li>
        id: <%= item.id %>; name: <%= item.name %>; type: <%=
        itemTypes.find(type => type.id === item.item_type_id).name %>; value:
        <%= item.value %>; weight: <%= item.weight %>;
      </li>
      <% }) %>
    </ul>
    <script src="/scripts/sliders.js"></script>
  </body>
</html>
