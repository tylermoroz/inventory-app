<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include("./partials/navbar", {itemTypes, weaponTypes, affinityTypes, spellTypes, spellSchools, potionTypes}) %> <%- include("./partials/errors") %>
    <h1><%= title %></h1>
    <ul class="inventory-container">
      <% inventory.forEach((item) => { %>
      <li class="inventory-item <%= item.item_type_id === 1 ? 'weapon' : item.item_type_id === 2 ? 'tome' : 'potion' %>"> 
        <div class="item-name-container">
          <h2 class="item-name"><%= item.name %></h2>
        </div>
        <div class="image-container">
          <% if (item.item_type_id === 1){ %>
                <%
                  const weapon = weapons.find(
                    weapon => weapon.shop_inventory_id === item.id
                  );

                  const weaponType = weaponTypes.find(
                    type => type.id === weapon.weapon_type_id
                  );

                  const affinityType = affinityTypes.find(
                    affinity => affinity.id === weapon.affinity_type_id
                  ); 
                %>
                <img src="/images/weapons/<%= affinityType.name.toLowerCase() %>_<%= weaponType.name.toLowerCase() %>.png" alt="<%= weapon.name %>, <%= affinityType.name %> <%= weaponType.name %>">
          <% } else if (item.item_type_id === 2) { %>
                <%
                  const tome = tomes.find(
                    tome => tome.shop_inventory_id === item.id
                  );

                  const spellType = spellTypes.find(
                    type => type.id === tome.spell_type_id
                  );

                  const spellSchool = spellSchools.find(
                    school => school.id === tome.spell_school_id
                  );
                %>
                <img src="/images/tomes/<%= spellSchool.name.toLowerCase() %>_<%= spellType.name.toLowerCase() %>.png" alt="<%= tome.name %>, <%= spellSchool.name %> <%= spellType.name %>">
          <% } else if (item.item_type_id === 3) { %> 
            <%
              const potion = potions.find(
                potion => potion.shop_inventory_id === item.id
              );

              const potionType = potionTypes.find(
                type => type.id === potion.potion_type_id
              );
            %>
            <div class="image-container">
              <img src="/images/potions/<%= potionType.name.toLowerCase() %>_potion.png" alt="<%= potion.name %>, <%= potionType.name %> potion">
            </div>
          <% } %>
        </div>
        <div class="item-info-container">
          <p class="item-id">id: <%= item.id %></p>
          <p class="item-type"><%=
          itemTypes.find(type => type.id === item.item_type_id).name %></p> 
          <p class="item-weight">Weight: <%= item.weight %></p>
          <p class="item-value">Value:
            <%= item.value %></p> 
        </div> 
      </li>
      <% }) %>
    </ul>
    <script src="/scripts/sliders.js"></script>
  </body>
</html>
