<nav>
  <ul class="nav-list">
    <li class="nav-item">
      <a href="/">
        <span>Inventory</span>
      </a>
    </li>
    <% itemTypes.forEach((type) => { %>
    <li class="nav-item">
      <a href="/<%= type.name %>s">
        <span> <%= type.name %>s </span>
      </a>
      <ul class="dropdown">
        <% if (type.name === "Weapon") { %>
          <li class="dropdown-item has-submenu">
            <span>Weapon Types</span>
            <ul class="submenu">
              <% weaponTypes.forEach((weaponType) => { %>
                <li class="submenu-item">
                  <a href="/weapons/type/<%= weaponType.name %>">
                    <%= weaponType.name %>
                  </a>
                </li>
              <% }) %>
            </ul>
          </li> 
          <li class="dropdown-item has-submenu">
            <span>Affinities</span>
            <ul class="submenu">
              <% affinityTypes.forEach((affinityType) => { %>
                <li class="submenu-item">
                  <a href="/weapon/affinity/<%= affinityType.name %>">
                    <%= affinityType.name %>
                  </a>
                </li>
              <% }) %>
            </ul>
          </li>
        <% } else if (type.name === "Tome")  { %>
          <li class="dropdown-item has-submenu">
            <span>Spell Types</span>
            <ul class="submenu">
              <% spellTypes.forEach((spellType) => { %>
                <li class="submenu-item">
                  <a href="/tomes/type/<%= spellType.name %>">
                    <span> <%= spellType.name %> </span>
                  </a>
                </li>
              <% }) %>
            </ul>
          </li>
          <li class="dropdown-item has-submenu">
            <span>Spell Schools</span>
            <ul class="submenu">
              <% spellSchools.forEach((spellSchool) => { %>
                <li class="submenu-item">
                  <a href="/tomes/school/<%= spellSchool.name %>">
                    <span> <%= spellSchool.name %> </span>
                  </a>
                </li>
              <% }) %>
            </ul>
          </li>  
        <% } else if (type.name === "Potion") { %>
          <li class="dropdown-item has-submenu">
            <span>Potion Types</span>
            <ul class="submenu">
              <% potionTypes.forEach((potionType) => { %>
                <li class="submenu-item">
                  <a href="/potions/type/<%= potionType.name %>">
                    <span> <%= potionType.name %> </span>
                  </a>
                </li>
              <% }) %> 
            </ul>
          </li> 
        <% } %>
      </ul>
    </li>
    <% }) %>
  </ul>
</nav>
