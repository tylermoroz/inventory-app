<nav>
  <ul class="nav-list">
    <li class="nav-item">
      <a href="/">
        <span>Inventory</span>
      </a>
    </li>
    <% itemTypes.forEach((type) => { %>
    <li class="nav-item">
      <a href="/<%= type.name %>s">
        <span>
          <%= type.name.charAt(0).toUpperCase() + type.name.slice(1) %>s
        </span>
      </a>
    </li>
    <% }) %>
  </ul>
</nav>
