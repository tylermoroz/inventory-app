<div class="form-container">
  <h2>Add Weapon</h2>
  <form action="/weapons" method="POST">
    <input type="hidden" name="returnTo" value="<%= returnTo %>">
    <div class="parent-input-container">
      <div class="name-input-container">
        <label for="name">Name: </label>
        <input type="text" name="name" id="name" required />
      </div>
      <div class="weapon-type-input-container">
        <label for="weapon_type_id">Weapon Type: </label>
        <select name="weapon_type_id" id="weapon_type_id">
          <% weaponTypes.forEach(type => { %>
          <option value="<%= type.id %>"><%= type.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="affinity-type-input-container">
        <label for="affinity_type_id">Affinity: </label>
        <select name="affinity_type_id" id="affinity_type_id">
          <% affinityTypes.forEach(type => { %>
          <option value="<%= type.id %>"><%= type.name %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="slider-container">
      <label for="damage">Damage: </label>
      <input class="stat-slider" type="range" name="damage" id="damage" min="1" max="1000" value="1" />
      <span class="slider-value">1</span>
    </div>
    <div class="slider-container">
      <label for="durability">Durability: </label>
      <input
        class="stat-slider"
        type="range"
        name="durability"
        id="durability"
        min="1"
        max="100"
        value="1"
      />
      <span class="slider-value">1</span>
    </div>
    <div class="slider-container">
      <label for="weight">Weight: </label>
      <input class="stat-slider" type="range" name="weight" id="weight" min="1" max="100" value="1" />
      <span class="slider-value">1</span>
    </div>
    <div class="value-input-container">
      <label for="value">Value: </label>
      <input type="number" name="value" id="value" min="1" max="1000" value="1" />
    </div>
    <div class="submit-button-container">
      <button type="submit">Submit</button>
    </div>
  </form>  
</div>