<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
</head>
<body>
    <div class="update-item-container">
        <h1><%= title %></h1>
        <%- include("../partials/errors") %>
        <div class="form-container">
            <form action="/tomes/<%= tome.id %>/update" method="POST" id="updateForm">
                <div class="parent-input-container">
                    <div class="name-input-container">
                        <label for="name">Name: </label>
                        <input type="text" name="name" id="name" value="<%= tome.name %>">
                    </div>
                    <div class="spell-type-input-container">
                        <label for="spell_type_id">Spell Type: </label>
                        <select name="spell_type_id" id="spell_type_id">
                        <% spellTypes.forEach((type) => { %>
                        <option value="<%= type.id %>" <%= type.id === tome.spell_type_id ? "selected" : "" %>
                        >
                        <%= type.name %>
                        </option>
                        <% }) %>
                        </select>
                    </div>
                    <div class="spell-school-input-container">
                        <label for="spell_school_id">Spell School: </label>
                        <select name="spell_school_id" id="spell_school_id">
                        <% spellSchools.forEach((school) => { %>
                        <option value="<%= school.id %>" <%= school.id === tome.spell_school_id ? "selected" : "" %>
                        >
                        <%= school.name %>
                        </option>
                        <% }) %>
                        </select>
                    </div>
                </div>
                <div class="slider-container">
                    <label for="mana_cost">Mana Cost: </label>
                    <input class="stat-slider" type="range" name="mana_cost" id="mana_cost" min="1" max="100" value="<%= tome.mana_cost %>" />
                    <span class="slider-value"><%= tome.mana_cost %></span>
                </div>
                <div class="slider-container">
                    <label for="weight">Weight: </label>
                    <input class="stat-slider" type="range" name="weight" id="weight" min="1" max="100" value="<%= tome.weight %>" />
                    <span class="slider-value"><%= tome.weight %></span>
                </div>
                <div class="value-input-container">
                    <label for="value">Value: </label>
                    <input type="number" name="value" id="value" min="1" max="1000" value="<%= tome.value %>" />
                </div>
                <div class="submit-button-container">
                    <button type="submit">Update Tome</button>
                </div>
            </form>
            <a href="/tomes">Back to Tomes</a>
        </div>
    </div>
    <script src="/scripts/sliders.js"></script>
    <script src="/scripts/secureUpdate.js"></script>
</body>
</html>