<html>
  <head>
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <%- include("./partials/navbar", {itemTypes, weaponTypes, affinityTypes, potionTypes}) %> <%-
    include("./partials/addTome", {spellTypes, spellSchools}) %>
    <h1><%= title %></h1>
    <ul>
      <% tomes.forEach((tome) => { %>
      <li>
        id: <%= tome.shop_inventory_id %>; name: <%= tome.name %>; spell type:
        <%= spellTypes.find(type => type.id === tome.spell_type_id).name %>;
        spell school: <%= spellSchools.find(school => school.id ===
        tome.spell_school_id).name %>; mana cost: <%= tome.mana_cost %>;
        <a href="/tomes/<%= tome.shop_inventory_id %>/update">Update</a>
        <form action="/<%= tome.shop_inventory_id %>/delete" method="POST">
          <button
            type="submit"
            onclick="return confirm('Are you sure this tome no longer belongs?');"
          >
            Delete
          </button>
        </form>
      </li>
      <% }) %>
    </ul>
  </body>
</html>
